#!/usr/bin/python3
# Runs at niri session start. Detects the outputs niri drives and writes
# ~/.config/niri/gregos-display.kdl: each output at its native resolution with
# its highest refresh rate, and the Noctalia settings window sized to the screen.
# The file is rewritten (and niri reloads) only when its content changes.
# Outputs already declared in the user's own niri config are left alone.

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

GENERATED = "gregos-display.kdl"
# Noctalia settings window size, as a share of a 2560x1440 screen (1080x920 there).
SETTINGS_W = 1080 / 2560
SETTINGS_H = 920 / 1440


def niri_outputs():
    for _ in range(20):
        result = subprocess.run(["niri", "msg", "--json", "outputs"], capture_output=True, text=True)
        if result.returncode == 0:
            return json.loads(result.stdout)
        time.sleep(0.5)
    sys.exit("gregos-niri-display-setup: niri IPC is not available")


def native_best_mode(output):
    modes = output.get("modes") or []
    if not modes:
        return None
    preferred = next((m for m in modes if m["is_preferred"]), None)
    if preferred is None:
        preferred = max(modes, key=lambda m: m["width"] * m["height"])
    native = [m for m in modes if (m["width"], m["height"]) == (preferred["width"], preferred["height"])]
    return max(native, key=lambda m: m["refresh_rate"])


def user_declared_outputs(config_dir):
    names = set()
    for path in config_dir.glob("*.kdl"):
        if path.name == GENERATED:
            continue
        names.update(re.findall(r'^\s*output\s+"([^"]+)"', path.read_text(), re.MULTILINE))
    return names


def primary_logical_size(outputs, modes):
    candidates = [n for n in modes if outputs[n].get("logical")]
    if not candidates:
        return None
    primary = next((n for n in candidates if outputs[n]["logical"]["x"] == 0 and outputs[n]["logical"]["y"] == 0), candidates[0])
    scale = outputs[primary]["logical"]["scale"]
    mode = modes[primary]
    return round(mode["width"] / scale), round(mode["height"] / scale)


def render(outputs, modes, declared):
    lines = [
        "// Generated by gregos-niri-display-setup at session start; changes are overwritten.",
        "// Override an output by declaring its `output \"NAME\"` block in config.kdl, and",
        "// the settings window size with a window-rule placed after the include line.",
        "",
    ]
    for name in sorted(modes):
        if name in declared:
            continue
        mode = modes[name]
        lines += [
            f'output "{name}" {{',
            f'  mode "{mode["width"]}x{mode["height"]}@{mode["refresh_rate"] / 1000:.3f}"',
            "}",
            "",
        ]
    size = primary_logical_size(outputs, modes) if modes else None
    if size is not None:
        width, height = size
        lines += [
            "window-rule {",
            '  match app-id="dev.noctalia.Noctalia"',
            f"  default-column-width {{ fixed {round(width * SETTINGS_W)}; }}",
            f"  default-window-height {{ fixed {round(height * SETTINGS_H)}; }}",
            "}",
            "",
        ]
    return "\n".join(lines)


def main():
    config_dir = Path(os.environ["HOME"]) / ".config" / "niri"
    config_dir.mkdir(parents=True, exist_ok=True)

    outputs = niri_outputs()
    modes = {}
    for name, output in outputs.items():
        mode = native_best_mode(output)
        if mode is not None:
            modes[name] = mode

    content = render(outputs, modes, user_declared_outputs(config_dir))
    target = config_dir / GENERATED
    if target.exists() and target.read_text() == content:
        return

    tmp = target.with_suffix(".kdl.tmp")
    tmp.write_text(content)
    os.replace(tmp, target)


if __name__ == "__main__":
    main()
