#!/bin/bash
# gregOS: prepare the Noctalia greeter's system state before greetd starts.
#
# This is intentionally small. Noctalia Greeter keeps all of its state under
# /var/lib/noctalia-greeter (greeter.toml, sync.toml, wallpapers), NOT under the
# greeter account's HOME, and its session wrapper creates its own
# XDG_RUNTIME_DIR. So the only things this service has to guarantee are:
#
#   1. The greeter account can read/write its DRM + input devices, i.e. it is a
#      member of the video/input/render groups. This is the one thing that makes
#      hardware rendering possible for the greeter's wlroots compositor.
#   2. Noctalia's persistent state exists, is owned by the greeter account, and
#      has been initialized (greeter.toml / sync.toml) via the upstream helper.
#
# Device group membership: on Fedora Atomic the base groups live in
# /usr/lib/group and systemd-sysusers' "m" lines are the supported way to add
# supplementary memberships. This script asserts the membership is present and
# repairs it if a rebase left it missing, without hand-editing /etc/group.

set -euo pipefail

greeter_user="greeter"
greeter_state="/var/lib/noctalia-greeter"
device_groups=(video input render)

echo "gregos-noctalia-greeter-setup: starting"

if ! account_record="$(getent passwd "${greeter_user}")"; then
    echo "gregos-noctalia-greeter-setup: user '${greeter_user}' does not exist" >&2
    exit 1
fi

# --- 1. Device group membership ---------------------------------------------
# systemd-sysusers applies the "m" lines from gregos-niri.conf on first boot.
# On a rebase where the account already existed, sysusers does not re-add
# memberships, so verify and repair through usermod. usermod writes local
# supplementary groups into /etc/group; the group *names* resolve fine through
# NSS even when the base record lives in /usr/lib/group.

missing_groups=()
for group in "${device_groups[@]}"; do
    if ! getent group "${group}" >/dev/null; then
        echo "gregos-noctalia-greeter-setup: group '${group}' is not present; skipping" >&2
        continue
    fi
    if id -nG "${greeter_user}" | tr ' ' '\n' | grep -qx "${group}"; then
        continue
    fi
    missing_groups+=("${group}")
done

if (( ${#missing_groups[@]} > 0 )); then
    echo "gregos-noctalia-greeter-setup: adding ${greeter_user} to: ${missing_groups[*]}"
    /usr/sbin/usermod --append --groups "$(IFS=,; echo "${missing_groups[*]}")" "${greeter_user}"
else
    echo "gregos-noctalia-greeter-setup: device group membership already present"
fi

# --- 2. Noctalia greeter state ----------------------------------------------
# Create the state dir and initialize greeter.toml / sync.toml exactly once.
# Noctalia's own helper (--setup-system) creates the directory, writes the
# config files, and chowns everything to the greeter account. Re-running it is
# idempotent but rewrites greeter.toml, so only invoke it when state is missing.

if [[ ! -f "${greeter_state}/greeter.toml" || ! -f "${greeter_state}/sync.toml" ]]; then
    echo "gregos-noctalia-greeter-setup: initializing Noctalia greeter state"
    GREETER_USER="${greeter_user}" /usr/bin/noctalia-greeter-apply-appearance --setup-system
else
    echo "gregos-noctalia-greeter-setup: Noctalia greeter state already present"
fi

# Repair ownership/mode on existing state without rewriting user configuration.
for config in "${greeter_state}/greeter.toml" "${greeter_state}/sync.toml"; do
    if [[ -f "${config}" ]]; then
        chown "${greeter_user}:${greeter_user}" "${config}"
        chmod 0644 "${config}"
    fi
done

echo "gregos-noctalia-greeter-setup: setup complete"
