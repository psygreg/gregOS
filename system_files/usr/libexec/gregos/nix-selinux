#!/bin/bash
#
# Install the Determinate Nix SELinux policy if the image build could not load
# it (for example when the build host had SELinux disabled). On a normal build
# build.sh already installs it, so this service exits immediately.
#
# The policy labels the Nix store, the daemon sockets and
# /usr/local/bin/determinate-nixd; without it the enforcing host can deny the
# daemon access to its own state on boot.

set -euo pipefail

policy_file=/usr/share/gregos/nix/selinux/determinate-nix.pp

if [[ ! -r "${policy_file}" ]]; then
    echo "the Determinate Nix SELinux policy is missing: ${policy_file}" >&2
    exit 1
fi

if ! command -v semodule >/dev/null 2>&1; then
    echo "semodule is not available; skipping the Determinate Nix SELinux policy"
    exit 0
fi

if semodule -l | awk '{ print $1 }' | grep -qx nix; then
    exit 0
fi

semodule -i "${policy_file}"
echo "Installed the Determinate Nix SELinux policy"
