[Unit]
Description=Seed and update the gregOS Determinate Nix store
Documentation=https://docs.determinate.systems/determinate-nix
DefaultDependencies=no
Requires=nix.mount
Wants=nix.mount
After=nix.mount systemd-sysusers.service
Before=nix-daemon.service nix-daemon.socket determinate-nixd.socket display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gregos/nix-seed
RemainAfterExit=yes
TimeoutStartSec=30min

[Install]
WantedBy=sockets.target
