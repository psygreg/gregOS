[Unit]
Description=Seed niri + Noctalia desktop configuration for existing users
Documentation=https://github.com/psygreg/gregOS
ConditionPathExists=/usr/share/gregos/niri/config.kdl
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/libexec/gregos/niri-config-seed
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
