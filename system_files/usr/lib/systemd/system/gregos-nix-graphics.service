[Unit]
Description=Expose host graphics and compute drivers for Nix applications
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/usr/lib/gregos/nix-graphics/libs.list

[Service]
Type=oneshot
ExecStart=/usr/libexec/gregos/nix-graphics
ExecStop=-/usr/bin/umount -l /run/opengl-driver
ExecStop=-/usr/bin/umount -l /run/opengl-driver-32
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
