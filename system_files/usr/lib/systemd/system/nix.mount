[Unit]
Description=Bind mount the persistent Nix store
Documentation=https://nixos.org/manual/nix/stable/installation/multi-user
DefaultDependencies=no
Requires=var-home-nix.service
After=var-home-nix.service
RequiresMountsFor=/var/home
Before=local-fs.target

[Mount]
What=/var/home/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
