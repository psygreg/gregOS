window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window. Proportions (1080x920 on 2560x1440) size it
// against the screen it opens on, so it works at any resolution and on any
// display of a multi-monitor setup. Override with a window-rule placed after the
// include line below.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { proportion 0.421875; }
  default-window-height { proportion 0.6388889; }
}

// Per-display settings (native resolution at the highest refresh rate),
// generated at session start by gregos-niri-display-setup. Optional: niri
// starts normally until the file exists.
include optional=true "~/.config/niri/gregos-display.kdl"

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

input {
    // Flat, unaccelerated pointer tracking (consistent feel for gaming/precise
    // mouse work). Keyboard, touchpad and other input settings are left at
    // niri's defaults; add sections here if you need to tune them.

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    // niri's built-in power key handling takes a logind handle-power-key
    // inhibitor at session start and suspends on every power key press
    // (hardcoded, config binds cannot override it). Disable it so the
    // XF86PowerOff bind below (session save, then power off) gets the key
    // instead; systemd-logind's own handling is ignored for short presses
    // through the shipped /etc/systemd/logind.conf.d/10-gregos-power-button
    // drop-in. Suspend stays available through Noctalia (session panel, lock
    // screen); bind XF86Suspend here if you want it on a key.
    disable-power-key-handling
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 26
}

binds {
    // Core Noctalia binds
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+P { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }
    Mod+W { focus-window-or-workspace-up; }
    Mod+S { focus-window-or-workspace-down; }
    Mod+Q { close-window; }

    // Navigation
    Mod+Shift+A { move-column-left; }
    Mod+Shift+D { move-column-right; }
    Mod+Shift+S { move-window-to-workspace-down; }
    Mod+Shift+W { move-window-to-workspace-up; }
    Mod+F { maximize-column; }
    Mod+F11 { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+C { center-column; }

    // 'Roll binds' - navigation
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Alt+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Alt+WheelScrollUp cooldown-ms=150 { focus-column-left; }

    // 'Roll binds' - volume
    Mod+Shift+WheelScrollDown cooldown-ms=150 { spawn-sh "noctalia msg volume-down"; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { spawn-sh "noctalia msg volume-up"; }

    Print { spawn-sh "noctalia msg screenshot-region"; }
    // Window screenshot uses niri's built-in capture (clipboard + ~/Pictures/
    // Screenshots). Noctalia's window capture (noctalia msg screenshot-window)
    // needs ext-image-copy-capture-v1 + ext-foreign-toplevel-image-capture-
    // source-manager-v1 support from niri; the built-in works regardless.
    Mod+Print { screenshot-window; }

    // Audio & Brightness
    // allow-when-locked=true keeps these working on the lock screen, matching
    // niri's default config for media keys.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Program shortcuts
    Mod+T { spawn "blackbox-terminal"; }

    // Session resume (niri-resume, see the spawn-at-startup "restore" entry
    // below): these run the tool's save-* commands, which write the session
    // snapshot first and only then perform the action. The "||" fallbacks
    // keep the bind's contract if niri-resume ever fails to save (a broken
    // IPC, a full disk): plain quit / poweroff still happen, they just skip
    // the snapshot.
    //
    // niri's default config binds Mod+Shift+E and Ctrl+Alt+Delete to plain
    // quit; this standalone config does not include it, so these binds add
    // the conventional escape keys with save semantics.
    Mod+Shift+E { spawn-sh "niri-resume save-quit || niri msg action quit"; }
    Ctrl+Alt+Delete { spawn-sh "niri-resume save-quit || niri msg action quit"; }

    // The physical power button. niri's hardcoded power key handling is
    // disabled above, and logind ignores short presses
    // (10-gregos-power-button.conf), so this bind is the one handler. It
    // works while the session is locked too (allow-when-locked): the
    // snapshot records the same running session and the machine powers off.
    // Outside a niri session (the greeter, a TTY) nothing binds the key and
    // a short press does nothing; logind's long-press fallback powers the
    // machine off instead.
    XF86PowerOff allow-when-locked=true { spawn-sh "niri-resume save-shutdown || systemctl poweroff"; }
}

layout {
    default-column-width { proportion 0.5; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

environment {
  // Restore dead-key / compose-key handling everywhere through ibus
  // (terminals such as BlackBox/ptyxis, GNOME Text Editor, etc.) with layouts
  // like us-intl, and enable full input-method (non-Latin) input.
  //
  // Since GTK 4.20 (GNOME 49+), GTK no longer implements dead-key and
  // X11-style compose sequences itself on Wayland: it delegates that to an
  // input-method framework via the text-input protocol. Qt's Wayland
  // text-input path does no composing either. ibus is installed by the
  // image (ibus-gtk3/ibus-gtk4 ship the GTK modules, Qt carries its own
  // ibus plugin) and started below with spawn-at-startup. Pointing every
  // toolkit at it gives consistent dead-key/compose behaviour regardless of
  // app toolkit, and also makes full CJK/other input methods available once
  // configured.
  //
  // The ibus XKB "keyboard" engine for this layout is preloaded via the
  // image's dconf system default (system_files/etc/dconf/db/ibus.d/
  // 50-gregos-defaults), so composing works with no first-run setup.
  // Layout/engines are user-configurable with `ibus-setup`.
  //
  // If ibus is ever removed from the image, delete these three lines to
  // restore toolkit-builtin behaviour (GTK composes via text-input, and
  // "GTK_IM_MODULE simple" / "QT_IM_MODULE compose" are the documented
  // fallback workarounds).
  GTK_IM_MODULE "ibus"
  QT_IM_MODULE "ibus"
  XMODIFIERS "@im=ibus"

  QT_QPA_PLATFORMTHEME "qt6ct"
  XCURSOR_THEME "Adwaita"
  XCURSOR_SIZE "26"
}

hotkey-overlay {
  skip-at-startup
}

spawn-at-startup "/usr/libexec/xdg-desktop-portal"
spawn-at-startup "/usr/libexec/xdg-desktop-portal-gtk"
spawn-at-startup "/usr/libexec/gregos/niri-display-setup"
// ibus-daemon: -d daemonize, -r replace a previous instance, -x enable XIM
// for Xwayland apps (XMODIFIERS=@im=ibus selects the XIM path).
spawn-at-startup "ibus-daemon" "-drx"
spawn-at-startup "noctalia"

// Session resume: replays the apps that were open when the previous session
// ended. The session-ending actions themselves run the tool first - Noctalia's
// Log out / Shut down / Reboot are overridden with "niri-resume save-*"
// commands (shipped in 15-gregos-session-actions.toml next to the other
// Noctalia defaults) - and the snapshot is written before the action fires, so
// there is no race. Started last in the startup sequence, so the shell and
// portals are already coming up when the recorded apps are relaunched and
// their windows re-placed.
spawn-at-startup "niri-resume" "restore"

include "noctalia.kdl"
