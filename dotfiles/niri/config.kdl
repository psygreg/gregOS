window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window. Its size is generated per display in
// gregos-display.kdl (see below).
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
}

// Per-display settings (native resolution at the highest refresh rate, and the
// settings window size), generated at session start by gregos-niri-display-setup.
// Optional: niri starts normally until the file exists.
include optional=true "~/.config/niri/gregos-display.kdl"

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

input {
    // Flat, unaccelerated pointer tracking (consistent feel for gaming/precise
    // mouse work). Keyboard, touchpad and other input settings are left at
    // niri's defaults; add sections here if you need to tune them.

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 26
}

binds {
    // Core Noctalia binds
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+P { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }
    Mod+W { focus-window-or-workspace-up; }
    Mod+S { focus-window-or-workspace-down; }
    Mod+Q { close-window; }

    // Navigation
    Mod+Shift+A { move-column-left; }
    Mod+Shift+D { move-column-right; }
    Mod+Shift+S { move-window-to-workspace-down; }
    Mod+Shift+W { move-window-to-workspace-up; }
    Mod+F { maximize-column; }
    Mod+F11 { fullscreen-window; }

    // 'Roll binds' - navigation
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Alt+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Alt+WheelScrollUp cooldown-ms=150 { focus-column-left; }

    // 'Roll binds' - volume
    Mod+Shift+WheelScrollDown cooldown-ms=150 { spawn-sh "noctalia msg volume-down"; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { spawn-sh "noctalia msg volume-up"; }

    Print { spawn-sh "noctalia msg screenshot-region"; }
    // Window screenshot uses niri's built-in capture (clipboard + ~/Pictures/
    // Screenshots). Noctalia's window capture (noctalia msg screenshot-window)
    // needs ext-image-copy-capture-v1 + ext-foreign-toplevel-image-capture-
    // source-manager-v1 support from niri; the built-in works regardless.
    Mod+Print { screenshot-window; }

    // Audio & Brightness
    // allow-when-locked=true keeps these working on the lock screen, matching
    // niri's default config for media keys.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Program shortcuts
    Mod+T { spawn "blackbox-terminal"; }
}

layout {
    default-column-width { proportion 0.5; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

environment {
  // Restore dead-key / compose-key handling everywhere through fcitx5
  // (terminals such as BlackBox/ptyxis, GNOME Text Editor, etc.) with layouts
  // like us-intl, and enable full input-method (non-Latin) input.
  //
  // Since GTK 4.20 (GNOME 49+), GTK no longer implements dead-key and
  // X11-style compose sequences itself on Wayland: it delegates that to an
  // input-method framework via the text-input protocol. Qt's Wayland
  // text-input path does no composing either. fcitx5 is installed by the
  // image (fcitx5-gtk ships the GTK2/3/4 modules, fcitx5-qt the Qt5/6 ones)
  // and started below with spawn-at-startup. Pointing every toolkit at it
  // gives consistent dead-key/compose behaviour regardless of app toolkit,
  // and also makes full CJK/other input methods available once configured.
  //
  // Layout and engine settings live in Noctalia-independent fcitx5 config;
  // edit with `fcitx5-config-qt` (fcitx5-configtool).
  //
  // If fcitx5 is ever removed from the image, delete these three lines to
  // restore toolkit-builtin behaviour (GTK composes via text-input, and
  // "GTK_IM_MODULE simple" / "QT_IM_MODULE compose" are the documented
  // fallback workarounds).
  GTK_IM_MODULE "fcitx"
  QT_IM_MODULE "fcitx"
  XMODIFIERS "@im=fcitx"

  QT_QPA_PLATFORMTHEME "qt6ct"
  XCURSOR_THEME "Adwaita"
  XCURSOR_SIZE "26"
}

hotkey-overlay {
  skip-at-startup
}

spawn-at-startup "/usr/libexec/xdg-desktop-portal"
spawn-at-startup "/usr/libexec/xdg-desktop-portal-gtk"
spawn-at-startup "/usr/libexec/gregos/niri-display-setup"
spawn-at-startup "fcitx5"
spawn-at-startup "noctalia"

include "noctalia.kdl"
