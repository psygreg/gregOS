window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

input {
    // ... outras configurações como o keyboard ...

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}

output "HDMI-A-1" {
    mode "2560x1440@119.998"
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 26
}

binds {
    // Core Noctalia binds
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+P { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }
    Mod+W { focus-window-or-workspace-up; }
    Mod+S { focus-window-or-workspace-down; }
    Mod+Q { close-window; }
    
    Mod+Shift+A { move-column-left; }
    Mod+Shift+D { move-column-right; }
    Mod+Shift+S { move-window-to-workspace-down; }
    Mod+Shift+W { move-window-to-workspace-up; }
    
    Print { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Print { screenshot-window; }

    // Audio & Brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
}

layout {
    default-column-width { proportion 0.9; }
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

environment {
  // Restore dead-key / compose-key handling in GTK4 apps (terminals such as
  // BlackBox/ptyxis, editors, etc.) with layouts like us-intl.
  //
  // Since GTK 4.20 (GNOME 49+), GTK no longer implements dead-key and
  // X11-style compose sequences itself on Wayland: it delegates that to an
  // input-method framework via the text-input protocol. This image has no
  // input-method daemon running in the niri session, so GTK4 apps receive
  // dead keys as plain keysyms and the accents never appear. Forcing the
  // built-in "simple" input-method module makes GTK fall back to its own
  // compose/dead-key implementation, which is the upstream-documented
  // workaround. If you later install and start a real input method (IBus or
  // Fcitx5), remove this line and set GTK_IM_MODULE to that framework's
  // name instead, or leave it unset to use the text-input protocol.
  GTK_IM_MODULE "simple"

  QT_QPA_PLATFORMTHEME "qt6ct"
  XCURSOR_THEME "Adwaita"
  XCURSOR_SIZE "26"
}

hotkey-overlay {
  skip-at-startup
}

spawn-at-startup "/usr/libexec/xdg-desktop-portal"
spawn-at-startup "/usr/libexec/xdg-desktop-portal-gtk"
spawn-at-startup "noctalia"

include "noctalia.kdl"
